{
  // Despliegue en Cloudflare Workers (sitio estático), espejo de
  // ingepresupuestos-web: `npx wrangler deploy` publica los assets de la
  // raíz del repo. Los custom domains (ingetrazo.com) se declaran en
  // routes — requieren que la zona exista en la cuenta de Cloudflare.
  "name": "ingetrazo-web",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  // worker.js solo corre para estas rutas: «/», «/apoyar», «/firma» y
  // «/extensiones» eligen el idioma (es/en/pt) por cookie, navegador y país;
  // las /extensiones-* leen el catálogo de GitHub. Todo lo demás sale
  // directo de los assets.
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/apoyar", "/firma", "/extensiones",
                         "/extensiones.json", "/extensiones-img/*",
                         "/extensiones-descarga/*"]
  },
  "routes": [
    { "pattern": "ingetrazo.com", "custom_domain": true },
    { "pattern": "www.ingetrazo.com", "custom_domain": true }
  ]
}
